generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  email                 String               @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  Role                 @default(USER)
  subscriptionTier      SubscriptionTier     @default(FREE)
  recommendationCredits Int                  @default(3)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  transactions          PaymentTransaction[]
  recommendationLogs    RecommendationLog[]
  wishlists             Wishlist[]

  @@map("users")
}

model Brand {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  logoUrl     String?
  websiteUrl  String?

  @@map("brands")
}

model FragranceNote {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  family      String
  description String?
  perfumes    PerfumeNote[]

  @@map("fragrance_notes")
}

model Perfume {
  id           Int      @id @default(autoincrement())
  url          String?
  perfume      String?
  brand        String?
  country      String?
  gender       String?
  rating_value Decimal? @db.Decimal(3, 2)
  rating_count Int?
  year         Int?
  top          String?
  middle       String?
  base         String?
  perfumer1    String?
  perfumer2    String?
  mainaccord1  String?
  mainaccord2  String?
  mainaccord3  String?
  mainaccord4  String?
  mainaccord5  String?
  approx_price Decimal? @db.Decimal(10, 2)
  season       String?
  occasion     String?
  intensity    String?

  @@map("perfumes")
}

model PerfumeNote {
  id        String        @id @default(cuid())
  perfumeId String
  noteId    String
  type      NoteCategory
  note      FragranceNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, noteId, type])
  @@map("perfume_notes")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  perfumeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
  @@map("wishlists")
}

model RecommendationLog {
  id                String   @id @default(cuid())
  userId            String?
  rawPrompt         String?
  parsedPreferences Json
  recommendedIds    String[]
  aiExplanation     String?
  feedbackRating    Int?
  createdAt         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])

  @@map("recommendation_logs")
}

model PaymentTransaction {
  id            String        @id @default(cuid())
  userId        String
  amount        Float
  currency      String        @default("INR")
  paymentMethod String
  paymentId     String?       @unique
  status        PaymentStatus @default(PENDING)
  creditsAdded  Int           @default(10)
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum GenderTarget {
  UNISEX
  MALE
  FEMALE
}

enum NoteCategory {
  TOP
  HEART
  BASE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
